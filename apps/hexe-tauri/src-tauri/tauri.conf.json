{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hexe",
  "version": "0.1.0",
  "identifier": "com.paloptic.hexe",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1520",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "hexe", "width": 1440, "height": 900, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hexe",
  "version": "0.1.0",
  "identifier": "org.gaia-systems.hexe",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1520",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Hexe", "width": 1440, "height": 900, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Hexe: procedural geometry node editor",
    "macOS": { "minimumSystemVersion": "11.0" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}

add box box1 @40,30
add grid grid1 @260,30
add polyextrude pe1 @40,140
add null out @260,140
ui wire box1 pe1 body
ui wire grid1 out 0
ui click box1
ui click grid1 shift
ui click pe1 shift
shot ~/.gaia/cache/hexe/proof/t3-multisel.png
ui drag grid1 120 40
shot ~/.gaia/cache/hexe/proof/t3-multisel-moved.png
ui key delete
save ~/.gaia/cache/hexe/proof/t3-multisel-after.json
shot ~/.gaia/cache/hexe/proof/t3-multisel-deleted.png
undo
save ~/.gaia/cache/hexe/proof/t3-multisel-undone.json
quit
